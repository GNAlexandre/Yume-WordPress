        "titre": "L'équipe",
        "contenu": "<!-- wp:image {\"id\":139,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"align\":\"center\"} -->\n<figure class=\"wp-block-image aligncenter size-large\"><img src=\"https://yumenovel.wordpress.com/wp-content/uploads/2024/10/copie-baneryumenovel2-1.jpg?w=1024\" alt=\"Bannière Yume Novel\" class=\"wp-image-139\" /></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"style\":{\"typography\":{\"textTransform\":\"uppercase\",\"letterSpacing\":\"2px\",\"textAlign\":\"center\"}}} -->\n<h2 class=\"wp-block-heading has-text-align-center\" style=\"letter-spacing:2px;text-transform:uppercase\">L'équipe Yume Novel</h2>\n<!-- /wp:heading -->\n\n<!-- wp:separator {\"className\":\"is-style-wide\"} -->\n<hr class=\"wp-block-separator has-alpha-channel-opacity is-style-wide\" />\n<!-- /wp:separator -->\n\n<!-- wp:group {\"style\":{\"color\":{\"background\":\"#efe7fb\"},\"spacing\":{\"padding\":{\"top\":\"1.5rem\",\"bottom\":\"1.5rem\",\"left\":\"1.5rem\",\"right\":\"1.5rem\"}},\"border\":{\"radius\":\"12px\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-background\" style=\"border-radius:12px;background-color:#efe7fb;padding-top:1.5rem;padding-right:1.5rem;padding-bottom:1.5rem;padding-left:1.5rem\"><!-- wp:heading {\"level\":3,\"style\":{\"typography\":{\"textAlign\":\"center\"}},\"fontSize\":\"large\"} -->\n<h3 class=\"wp-block-heading has-text-align-center has-large-font-size\">La direction</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center\"><strong>Mael7523m</strong> — Gérant de la Yume Novel, traducteur / relecteur<br><strong>𝓦𝖆𝖓ø𝖝𝖝</strong> — Co-gérant, traducteur / relecteur<br><strong>Calumi</strong> — Co-gérant, traducteur / relecteur<br><strong>Angeloids</strong> — Co-gérant, traducteur / relecteur</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:spacer {\"height\":\"24px\"} -->\n<div style=\"height:24px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#f5f0fa\"},\"spacing\":{\"padding\":{\"top\":\"1.5rem\",\"bottom\":\"1.5rem\",\"left\":\"1.5rem\",\"right\":\"1.5rem\"}},\"border\":{\"radius\":\"12px\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-background\" style=\"border-radius:12px;background-color:#f5f0fa;padding-top:1.5rem;padding-right:1.5rem;padding-bottom:1.5rem;padding-left:1.5rem\"><!-- wp:heading {\"level\":3,\"style\":{\"typography\":{\"textAlign\":\"center\"}},\"fontSize\":\"large\"} -->\n<h3 class=\"wp-block-heading has-text-align-center has-large-font-size\">Traduction <span style=\"font-weight:400\">(LN)</span></h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center\"><strong>Cerale<br>Opale<br>MoonKissed</strong></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#f5f0fa\"},\"spacing\":{\"padding\":{\"top\":\"1.5rem\",\"bottom\":\"1.5rem\",\"left\":\"1.5rem\",\"right\":\"1.5rem\"}},\"border\":{\"radius\":\"12px\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-background\" style=\"border-radius:12px;background-color:#f5f0fa;padding-top:1.5rem;padding-right:1.5rem;padding-bottom:1.5rem;padding-left:1.5rem\"><!-- wp:heading {\"level\":3,\"style\":{\"typography\":{\"textAlign\":\"center\"}},\"fontSize\":\"large\"} -->\n<h3 class=\"wp-block-heading has-text-align-center has-large-font-size\">Relecture <span style=\"font-weight:400\">(LN)</span></h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center\"><strong>Shadowadow</strong></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:spacer {\"height\":\"24px\"} -->\n<div style=\"height:24px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#f5f0fa\"},\"spacing\":{\"padding\":{\"top\":\"1.5rem\",\"bottom\":\"1.5rem\",\"left\":\"1.5rem\",\"right\":\"1.5rem\"}},\"border\":{\"radius\":\"12px\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-background\" style=\"border-radius:12px;background-color:#f5f0fa;padding-top:1.5rem;padding-right:1.5rem;padding-bottom:1.5rem;padding-left:1.5rem\"><!-- wp:heading {\"level\":3,\"style\":{\"typography\":{\"textAlign\":\"center\"}},\"fontSize\":\"large\"} -->\n<h3 class=\"wp-block-heading has-text-align-center has-large-font-size\">Traduction &amp; Relecture <span style=\"font-weight:400\">(Manga)</span></h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center\"><em>Poste à pourvoir — en recrutement</em></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#f5f0fa\"},\"spacing\":{\"padding\":{\"top\":\"1.5rem\",\"bottom\":\"1.5rem\",\"left\":\"1.5rem\",\"right\":\"1.5rem\"}},\"border\":{\"radius\":\"12px\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-background\" style=\"border-radius:12px;background-color:#f5f0fa;padding-top:1.5rem;padding-right:1.5rem;padding-bottom:1.5rem;padding-left:1.5rem\"><!-- wp:heading {\"level\":3,\"style\":{\"typography\":{\"textAlign\":\"center\"}},\"fontSize\":\"large\"} -->\n<h3 class=\"wp-block-heading has-text-align-center has-large-font-size\">Design</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center\"><strong>JojoGg</strong> — Graphiste &amp; Clean / Qedit manga<br><strong>Raitei</strong> — Consultant de la J-Garden</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:spacer -->\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->"
