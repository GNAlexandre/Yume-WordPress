        "content": "<!-- wp:image {\"id\":6,\"width\":\"158px\",\"height\":\"auto\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"center\"} -->\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img src=\"https://yumenovel.wordpress.com/wp-content/uploads/2024/10/cropped-logo.png\" alt=\"\" class=\"wp-image-6\" style=\"width:158px;height:auto\" /></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"align\":\"center\"} -->\n<p class=\"has-text-align-center\">Nous sommes la Yume Novel, une team de traduction fan. Elle a vu le jour en 2022 sous le nom de \"Roshidere France\", notre but est de mettre la lumière sur les Light Novel. </p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"align\":\"center\"} -->\n<p class=\"has-text-align-center\"><strong>Crée par Mael7523m.</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:image {\"id\":145,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://yumenovel.wordpress.com/wp-content/uploads/2024/10/cheikhspeare_makoto_shinkai_style_sakura_trees_wallpaper_with_k_f61b1e80-f4ba-4d76-be46-6fea6090b4e3-1.png?w=1024\" alt=\"\" class=\"wp-image-145\" /></figure>\n<!-- /wp:image -->\n\n<!-- wp:spacer -->\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->"
