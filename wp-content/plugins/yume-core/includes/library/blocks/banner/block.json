{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "yume/banner",
	"title": "Bannière du site",
	"category": "yume",
	"icon": "format-image",
	"description": "Bannière actuelle du site (réglage Yume → Réglages), pleine largeur.",
	"keywords": [
		"bannière",
		"accueil",
		"image"
	],
	"textdomain": "yume-core",
	"attributes": {
		"height": {
			"type": "number",
			"default": 240,
			"label": "Hauteur (px)"
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"render": "file:./render.php",
	"style": "file:./style.css"
}
