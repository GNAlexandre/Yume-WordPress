{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "yume/oeuvre-news",
	"title": "Actualités de l’œuvre",
	"category": "yume",
	"icon": "megaphone",
	"description": "Articles liés à l’œuvre (annonces de sortie comprises) : liste paginée, ou encart « Dernières actualités » avec une limite.",
	"keywords": [
		"actualités",
		"articles",
		"œuvre"
	],
	"textdomain": "yume-core",
	"attributes": {
		"limite": {
			"type": "number",
			"default": 0,
			"label": "Nombre d’articles (0 : liste complète paginée)"
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"align": [
			"wide"
		]
	},
	"render": "file:./render.php",
	"style": "file:./style.css"
}
